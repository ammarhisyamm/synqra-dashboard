# Copy to .dev.vars for local `wrangler dev` (never commit real values).
# Cloudflare secrets (production): wrangler secret put <NAME>

# Orvix AI — server-side only (worker/ai.js). Never expose to the client.
ORVIX_API_KEY=

# Resend — invite emails (worker/email.js). Empty = invites saved, email skipped.
RESEND_API_KEY=
# Optional sender, defaults to Synqra <onboarding@resend.dev>
EMAIL_FROM=

# Bindings (wrangler.jsonc, not env vars): D1 `DB`, R2 `ATTACHMENTS`, Assets `ASSETS`.
