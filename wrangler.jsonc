{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "synqra-dashboard",
  "main": "worker.js",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
