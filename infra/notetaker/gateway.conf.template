# Only the adapter's narrow bot/transcript/media endpoints are reachable.
# Never expose Vexa's admin API, agent/terminal, debug browser or object store.
server {
  listen 8056;
  server_tokens off;
  client_max_body_size 32k;
  access_log off;
  location ~ ^/(bots(/status|/(google_meet|zoom)/[a-z0-9-]+)?|transcripts/by-id/[0-9]+|recordings(/[0-9]+/(master|media/[0-9]+/raw))?)$ {
    proxy_pass http://vexa:8056;
    proxy_set_header Host $host;
    proxy_set_header X-API-Key $http_x_api_key;
    proxy_set_header X-Admin-API-Key "";
    proxy_set_header Authorization "";
    proxy_read_timeout 60s;
    proxy_buffering off;
  }
  location / { return 404; }
}
server {
  listen 8057;
  server_tokens off;
  client_max_body_size 128k;
  access_log off;
  location = /api/generate {
    if ($http_authorization != "Bearer ${NOTETAKER_SUMMARY_KEY}") { return 401; }
    limit_except POST { deny all; }
    # Resolve on demand: local-ai is optional and can be disabled.
    resolver 127.0.0.11 valid=30s;
    set $summary_backend http://ollama:11434;
    proxy_pass $summary_backend;
    proxy_set_header Authorization "";
    proxy_read_timeout 30s;
  }
  location / { return 404; }
}
